# ============================================================
# CosmoCraft - Переменные окружения
# ============================================================

# ============================================================
# БАЗА ДАННЫХ
# ============================================================
DB_HOST=localhost
DB_USER=cosmocraft_user
DB_PASSWORD=your_secure_password_here
DB_NAME=cosmocraft

# ============================================================
# СЕРВЕР
# ============================================================
SERVER_PORT=8080
CLIENT_PORT=8001

# ============================================================
# ИГРА
# ============================================================
WORLD_SEED=12345

# ============================================================
# КОНФИГУРАЦИЯ ПИЛОТИРОВАНИЯ
# ============================================================
MAX_SPEED=800
ACCELERATION=200
ROTATION_SPEED=3.0
DAMPING=0.95
MOUSE_SENSITIVITY=0.003
WASD_ARROWS_DUPLICATE=true
HIDE_SHIP=true
SHOW_GUN_HUD=true

# ============================================================
# БЕЗОПАСНОСТЬ
# ============================================================

# Секретный ключ для обфускации имён игроков
OBFUSCATION_SECRET=change_this_to_random_secret_2026

# ============================================================
# JWT ТОКЕНЫ
# ============================================================

# Секретные ключи для JWT (смените на случайные строки!)
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production_2026
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production_2026

# Время жизни токенов
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
# БЕЗОПАСНОСТЬ АВТОРИЗАЦИИ
# ============================================================

# Максимальное количество неудачных попыток входа до блокировки
MAX_LOGIN_ATTEMPTS=5

# Длительность блокировки аккаунта (в минутах)
LOCKOUT_DURATION_MINUTES=15

# Минимальная длина пароля
PASSWORD_MIN_LENGTH=8

# Требовать сложный пароль (заглавные, строчные, цифры, спецсимволы)
REQUIRE_STRONG_PASSWORD=true

# Таймаут сессии (дней)
SESSION_TIMEOUT_DAYS=30

# Rate limiting окно (минуты)
RATE_LIMIT_WINDOW_MINUTES=15

# Максимум запросов в окно rate limiting
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# EMAIL СЕРВЕР (SMTP)
# ============================================================

# Включить email уведомления (true/false)
EMAIL_ENABLED=false

# SMTP сервер
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587

# Использовать SSL/TLS (true для порта 465, false для 587)
EMAIL_SECURE=false

# Учётные данные SMTP
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password_here

# Отправитель
EMAIL_FROM=noreply@cosmocraft.game
EMAIL_FROM_NAME=CosmoCraft

# ============================================================
# БЕЛЫЙ СПИСОК IP
# ============================================================

# Включить проверку белого списка IP (true/false)
IP_WHITELIST_ENABLED=false

# ============================================================
# HTTPS / SSL
# ============================================================

# Использовать HTTPS (true/false)
HTTPS_ENABLED=false

# Пути к SSL сертификатам (для продакшена)
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# ============================================================
# ЛОГИРОВАНИЕ
# ============================================================

# Уровень логирования (error, warn, info, debug)
LOG_LEVEL=info

# Логировать все запросы (true/false)
LOG_REQUESTS=false

# ============================================================
# АДМИН-ПАНЕЛЬ
# ============================================================

# Включить админ-панель (true/false)
ADMIN_ENABLED=true

# JWT секрет для админ-панели (смените на случайную строку!)
ADMIN_JWT_SECRET=change_this_to_random_secret_for_admin_2026

# Таймаут сессии администратора (часов)
ADMIN_SESSION_TIMEOUT_HOURS=8

# Требовать 2FA для администраторов (true/false)
ADMIN_2FA_REQUIRED=false

# Белый список IP для админ-панели (через запятую)
ADMIN_IP_WHITELIST=127.0.0.1
ADMIN_IP_WHITELIST_ENABLED=false

# CORS для админ-панели
ADMIN_CORS_ENABLED=true
ADMIN_CORS_ORIGINS=http://localhost:8001,http://localhost:8080

# Только HTTPS для админ-панели (true/false)
ADMIN_HTTPS_ONLY=false

# Логирование админ-панели
ADMIN_LOG_ENABLED=true
ADMIN_LOG_LEVEL=info
ADMIN_LOG_MAX_AGE_DAYS=30

# ============================================================
# ПРЕДЫДУЩИЕ НАСТРОЙКИ
# ============================================================

# Разрешить CORS (для разработки)
CORS_ENABLED=true

# Домены для CORS (через запятую)
CORS_ORIGINS=http://localhost:8001,http://localhost:3000

# ============================================================
# ПРИМЕРЫ НАСТРОЕК ДЛЯ РАЗЛИЧНЫХ СРЕД
# ============================================================

# === РАЗРАБОТКА (локально) ===
# EMAIL_ENABLED=false
# IP_WHITELIST_ENABLED=false
# HTTPS_ENABLED=false
# LOG_LEVEL=debug

# === ПРОДАКШЕН (сервер) ===
# EMAIL_ENABLED=true
# EMAIL_HOST=smtp.yourserver.com
# EMAIL_PORT=465
# EMAIL_SECURE=true
# IP_WHITELIST_ENABLED=true
# HTTPS_ENABLED=true
# LOG_LEVEL=info
# REQUIRE_STRONG_PASSWORD=true
