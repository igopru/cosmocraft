# ⚡ Энергия и ресурсы CosmoCraft
# Коэффициенты и параметры баланса

# ============================================================
# ЭНЕРГИЯ ОТ ЗВЕЗДЫ
# ============================================================

# Зарядка энергией от звезды (единиц/сек)
STAR_CHARGE_CLOSE=100      # Внутри ауры (< 100 единиц)
STAR_CHARGE_MEDIUM=30      # Рядом с аурой (100-300 единиц)
STAR_CHARGE_FAR=5          # Далеко от звезды (> 300 единиц)

# Радиусы зон звезды
STAR_AURA_RADIUS=100       # Внутренняя аура (максимальная зарядка)
STAR_MEDIUM_RADIUS=300     # Средняя зона (средняя зарядка)
STAR_FAR_RADIUS=1000       # Дальняя зона (минимальная зарядка)

# Радиация от звезды (% в секунду)
STAR_RADIATION_AURA=5      # В ауре (+5% в сек)
STAR_RADIATION_MEDIUM=2    # В средней зоне (+2% в сек)
STAR_RADIATION_FAR=0       # Далеко (0% в сек)

# ============================================================
# РАСХОД ЭНЕРГИИ
# ============================================================

# Лазер (единиц энергии за выстрел)
LASER_ENERGY_COST=1        # Базовый расход
LASER_ENERGY_PRESTIGE_2=2  # Престиж 2
LASER_ENERGY_PRESTIGE_3=3  # Престиж 3
LASER_ENERGY_PRESTIGE_4=5  # Престиж 4+

# Двигатели (единиц энергии в секунду при 100% тяге)
ENGINE_ENERGY_COST=10      # Базовый расход

# ============================================================
# РАСХОД ВОДЫ (ДВИГАТЕЛИ)
# ============================================================

# Вода (единиц в секунду при 100% тяге)
WATER_CONSUMPTION=1        # 1 единица в секунду

# Начальный запас воды
WATER_TANK_CAPACITY=100    # 100% бака
WATER_TANK_START=100       # Старт с полным баком

# ============================================================
# ЁМКОСТЬ ЭНЕРГИИ
# ============================================================

# Максимальный запас энергии корабля
ENERGY_CAPACITY=1000       # Единиц энергии
ENERGY_START=500           # Старт с 50% заряда

# Скорость зарядки/разрядки
ENERGY_CHARGE_RATE=1       # Коэффициент зарядки
ENERGY_DRAIN_RATE=1        # Коэффициент разрядки

# ============================================================
# РЕСУРСЫ ИЗ АСТЕРОИДОВ
# ============================================================

# Металлические астероиды
METAL_PER_VOXEL=10         # Единиц металла за воксель
METAL_VOXELS_PER_HIT=1     # Вокселей за выстрел

# Кремниевые астероиды
SILICON_PER_VOXEL=8        # Единиц кремния за воксель
SILICON_VOXELS_PER_HIT=2   # Вокселей за выстрел

# Ледяные астероиды
ICE_PER_VOXEL=12           # Единиц льда за воксель
ICE_VOXELS_PER_HIT=2       # Вокселей за выстрел
WATER_FROM_ICE=5           # Единиц воды из 1 льда (переработка)

# Редкие астероиды
RARE_PER_VOXEL=3           # Единиц редких за воксель
RARE_VOXELS_PER_HIT=3      # Вокселей за выстрел

# ============================================================
# СТОЛКНОВЕНИЯ
# ============================================================

# Урон щитам
COLLISION_ASTEROID_DAMAGE=15    # % щитов за астероид
COLLISION_VOXEL_DAMAGE=5        # % щитов за воксель
COLLISION_STAR_DAMAGE=100       # % щитов за звезду (мгновенная смерть)

# Отскок при столкновении
COLLISION_BOUNCE_FORCE=20       # Сила отскока
COLLISION_SPEED_LOSS=0.5        # Потеря скорости (50%)

# Неуязвимость после столкновения
COLLISION_INVULNERABILITY=1000  # мс

# ============================================================
# ПРЕСТИЖ (множители сложности)
# ============================================================

# Множители расхода энергии
PRESTIGE_1_ENERGY_MULT=1.0
PRESTIGE_2_ENERGY_MULT=1.5
PRESTIGE_3_ENERGY_MULT=2.0
PRESTIGE_4_ENERGY_MULT=3.0

# Множители радиации
PRESTIGE_1_RAD_MULT=1.0
PRESTIGE_2_RAD_MULT=1.2
PRESTIGE_3_RAD_MULT=1.5
PRESTIGE_4_RAD_MULT=2.0

# ============================================================
# ЗВЕЗДА (параметры)
# ============================================================

# Температура (влияет на радиацию)
STAR_BASE_TEMPERATURE=300    # Кельвинов (база)
STAR_AURA_TEMPERATURE=1000   # В ауре

# Гравитация (притяжение к звезде)
STAR_GRAVITY=0.1             # Сила притяжения
STAR_GRAVITY_AURA=0.5        # В ауре (сильнее)

# ============================================================
# КОНЕЦ ИГРЫ
# ============================================================

# Условия поражения
GAME_OVER_STAR_COLLISION=true   # Столкновение со звездой = смерть
GAME_OVER_SHIELDS_ZERO=true      # Щиты = 0 = респавн
GAME_OVER_ENERGY_ZERO=false      # Энергия = 0 = дрейф (не смерть)

# Сохранение статистики
SAVE_CARGO_ON_DEATH=false        # Терять ли груз при смерти
SAVE_CREDITS_ON_DEATH=true       # Сохранять кредиты
