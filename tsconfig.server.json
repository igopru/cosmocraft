{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/server/**/*",
    "src/station/**/*",
    "src/asteroids/**/*",
    "src/star/**/*",
    "src/types/**/*",
    "src/world/**/*"
  ],
  "exclude": ["node_modules", "public", "src/client", "src/ui"]
}
