{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM"],
    "outDir": "./public/dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "paths": {
      "three/addons/*": ["./node_modules/@types/three/examples/jsm/*"]
    }
  },
  "include": [
    "src/client/**/*",
    "src/ui/**/*",
    "src/types/**/*",
    "src/designer/**/*",
    "src/shared/**/*"
  ],
  "exclude": ["node_modules", "dist", "src/server"]
}
