{
  "name": "cosmocraft",
  "version": "0.6.1",
  "description": "Многопользовательская космическая стратегия с воксельной графикой, системой заданий и админ-панелью",
  "scripts": {
    "migrate": "node scripts/migrate-json-to-mysql.cjs",
    "db:init": "node scripts/database/init-database.js",
    "db:init-auth": "mysql -u ${DB_USER:-root} -p${DB_PASSWORD:-} ${DB_NAME:-cosmocraft} < scripts/database/auth-schema.sql",
    "db:backup": "mysqldump -u ${DB_USER:-root} -p${DB_PASSWORD:-} ${DB_NAME:-cosmocraft} > backups/cosmocraft_$(date +%Y%m%d_%H%M%S).sql",
    "db:restore": "mysql -u ${DB_USER:-root} -p${DB_PASSWORD:-} ${DB_NAME:-cosmocraft} < backups/latest.sql",
    "build:client": "tsc --project tsconfig.client.json",
    "build:server": "tsc --project tsconfig.server.json",
    "build": "npm run build:server && npm run build:client",
    "watch:client": "tsc --project tsconfig.client.json --watch",
    "watch:server": "tsc --project tsconfig.server.json --watch",
    "start": "node dist/server/GameServer.js",
    "dev": "nodemon"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.18.0",
    "nodemailer": "^6.9.8",
    "simplex-noise": "^4.0.3",
    "speakeasy": "^2.0.0",
    "three": "^0.183.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^25.3.5",
    "@types/nodemailer": "^6.4.14",
    "@types/speakeasy": "^2.0.10",
    "@types/three": "^0.183.1",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
